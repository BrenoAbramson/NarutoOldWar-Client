ModernTradeWindow < MainWindow
  !text: tr('Troca')
  size: 620 490

  Label
    id: statusLabel
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  Label
    id: ownLabel
    anchors.top: statusLabel.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-left: 24
    !text: tr('Sua oferta')

  Label
    id: partnerLabel
    anchors.top: statusLabel.bottom
    anchors.left: parent.horizontalCenter
    margin-top: 14
    margin-left: 16

  ScrollableFlatPanel
    id: ownOffer
    anchors.top: ownLabel.bottom
    anchors.left: parent.left
    margin-top: 5
    margin-left: 24
    size: 244 142
    border-width: 1
    padding: 3
    vertical-scrollbar: ownScroll
    layout:
      type: grid
      cell-size: 40 40
      cell-spacing: 3
      num-columns: 4

  VerticalScrollBar
    id: ownScroll
    anchors.top: ownOffer.top
    anchors.bottom: ownOffer.bottom
    anchors.left: ownOffer.right
    margin-left: 2
    step: 43
    pixels-scroll: true

  ScrollableFlatPanel
    id: partnerOffer
    anchors.top: partnerLabel.bottom
    anchors.left: parent.horizontalCenter
    margin-top: 5
    margin-left: 16
    size: 244 142
    border-width: 1
    padding: 3
    vertical-scrollbar: partnerScroll
    layout:
      type: grid
      cell-size: 40 40
      cell-spacing: 3
      num-columns: 4

  VerticalScrollBar
    id: partnerScroll
    anchors.top: partnerOffer.top
    anchors.bottom: partnerOffer.bottom
    anchors.left: partnerOffer.right
    margin-left: 2
    step: 43
    pixels-scroll: true

  Label
    id: ownBalance
    anchors.top: ownOffer.bottom
    anchors.left: ownOffer.left
    margin-top: 12

  Label
    id: ownBankTitle
    anchors.top: ownBalance.bottom
    anchors.left: ownOffer.left
    margin-top: 9
    !text: tr('Oferecer do banco (Ryou)')

  Label
    id: partnerBankTitle
    anchors.top: partnerOffer.bottom
    anchors.left: partnerOffer.left
    margin-top: 12
    !text: tr('Saldo bancario oferecido')

  TextEdit
    id: bankInput
    anchors.top: ownBankTitle.bottom
    anchors.left: ownOffer.left
    anchors.right: ownOffer.right
    margin-top: 3
    height: 24

  Label
    id: partnerBank
    anchors.top: partnerBankTitle.bottom
    anchors.left: partnerOffer.left
    margin-top: 8

  Label
    id: approvalStatus
    anchors.bottom: approveButton.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 12

  Button
    id: approveButton
    anchors.bottom: cancelButton.top
    anchors.left: parent.left
    margin-left: 90
    margin-bottom: 10
    width: 135
    !text: tr('Aprovar oferta')
    enabled: false
    @onClick: modules.game_modern_trade.approve()

  Button
    id: confirmButton
    anchors.bottom: cancelButton.top
    anchors.right: parent.right
    margin-right: 90
    margin-bottom: 10
    width: 135
    !text: tr('Confirmar troca')
    enabled: false
    @onClick: modules.game_modern_trade.confirm()

  Button
    id: cancelButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 14
    width: 120
    !text: tr('Cancelar')
    @onClick: modules.game_modern_trade.cancel()
